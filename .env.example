# ========================================
# Environment Variables - Template
# ========================================
# Copy file ini ke .env dan isi dengan nilai sebenarnya
# JANGAN commit .env ke git!
# ========================================

# LOGGING & DEBUG
# ========================================
DEBUG=False
LOG_LEVEL=INFO
# Pilihan: DEBUG, INFO, WARNING, ERROR, CRITICAL

LOG_FILE=logs/kalkulator_saham.log
LOG_MAX_SIZE=10485760
# Ukuran file log sebelum rotate (10MB default)

# API CONFIGURATION
# ========================================
YFINANCE_TIMEOUT=10
# Timeout untuk yfinance API call (detik)

YFINANCE_MAX_RETRIES=3
# Jumlah retry jika API gagal

YFINANCE_ENABLED=True
# Enable/disable yfinance integration

# DATA VALIDATION
# ========================================
MIN_TICKER_LENGTH=3
MAX_TICKER_LENGTH=10
# Batasan panjang ticker saham

MIN_WACC=0.5
MAX_WACC=20.0
# Batasan WACC dalam persen

MIN_GROWTH_RATE=-10.0
MAX_GROWTH_RATE=30.0
# Batasan growth rate dalam persen

MIN_PE_RATIO=1.0
MAX_PE_RATIO=100.0
# Batasan P/E ratio

MIN_PBV_RATIO=0.1
MAX_PBV_RATIO=10.0
# Batasan P/BV ratio

# CALCULATION DEFAULTS
# ========================================
DEFAULT_MOS=30
# Default Margin of Safety (persen)

DCF_PROJECTION_YEARS=5
# Tahun proyeksi untuk DCF method

DCF_TERMINAL_GROWTH=3.0
# Default terminal growth rate (%)

GRAHAM_MULTIPLE=22.5
# Graham Number multiplier (standard 22.5)

# FILE OPERATIONS
# ========================================
MAX_FILE_SIZE=104857600
# Ukuran file maksimal (100MB)

ALLOWED_FILE_EXTENSIONS=.py,.json,.md,.txt,.csv,.xlsx
# Ekstensi file yang diperbolehkan

BLOCKED_FILE_EXTENSIONS=.exe,.bat,.sh,.cmd,.ps1,.dll,.so
# Ekstensi file yang diblokir

# OUTPUT FORMAT
# ========================================
CURRENCY=IDR
DECIMAL_PLACES=2
# Format output untuk nilai uang

THOUSAND_SEPARATOR=.
DECIMAL_SEPARATOR=,
# Separator untuk format Indonesia

# SECURITY
# ========================================
REQUIRE_INPUT_VALIDATION=True
# Validasi ketat untuk semua input

SANITIZE_OUTPUT=True
# Sanitasi output untuk prevent injection

HIDE_ERROR_DETAILS=True
# Jangan tampilkan stack trace ke user

LOG_SENSITIVE_DATA=False
# JANGAN log password, API keys, dll

# FEATURE FLAGS
# ========================================
ENABLE_GRAHAM_METHOD=True
ENABLE_DCF_METHOD=True
ENABLE_PE_PBV_METHOD=True
# Enable/disable valuation methods

ENABLE_SENSITIVITY_ANALYSIS=True
# Show sensitivity table untuk DCF

ENABLE_DEMO_MODE=True
# Enable demo scripts & examples

# ========================================
# CATATAN PENTING:
# ========================================
# 1. JANGAN commit file .env ke git
#    - Tambahkan .env ke .gitignore
# 2. Setiap deployment perlu .env baru
#    - Jangan copy .env dari dev ke prod
# 3. Untuk development saja
#    - Production minta via secret manager
# 4. Rotate sensitive values secara berkala
#    - Khususnya API keys & passwords
# 5. Review .env.example jika ada perubahan
#    - Update dokumentasi jika ada var baru
# ========================================
